{
  "expo": {
    "name": "カミめぐ",
    "slug": "goshuin-app",
    "scheme": "goshuinapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-amaterasu.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.koheip.kamimegu",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.koheip.kamimegu",
      "adaptiveIcon": {
        "backgroundColor": "#FFF3FA",
        "foregroundImage": "./assets/android-icon-amaterasu-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-font",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF3FA",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "御朱印を撮影して記録するためにカメラを使用します。",
          "photosPermission": "撮影済みの御朱印の写真を選んで記録するために写真ライブラリを使用します。",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "参拝した神社・お寺の場所を記録し、近くの神社・お寺を探すために現在地を使用します。"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a276c60f-1a5e-4b18-83bc-e5a3d9618bd2"
      }
    },
    "owner": "koheip"
  }
}
